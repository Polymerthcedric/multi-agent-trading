# Generate a unique value, for example with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRADINGVIEW_WEBHOOK_SECRET=

# WhatsApp Alerts (Kenya - free via CallMeBot)
# 1. Save +34 644 10 55 84 in your phone contacts
# 2. Send "I allow callmebot to send me messages" to that number
# 3. Wait for API key reply
WHATSAPP_PHONE=
WHATSAPP_API_KEY=

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard is local by default. Set to 0.0.0.0 for access from your LAN.
DASHBOARD_ADDRESS=127.0.0.1
WEBHOOK_HOST=127.0.0.1

# Ports
DASHBOARD_PORT=8501
WEBHOOK_PORT=8000
